/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./build",
    "rootDir": "./src",
    "baseUrl": ".",
    "lib": [
      "es2020",
      "dom"
    ]
  },
  "include": [
    "src/**/*",
    "types/assets.d.ts"
  ],
  "exclude": []
}
