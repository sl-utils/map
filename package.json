{
  "name": "@sl-utils/map",
  "version": "1.0.18",
  "description": "Map utility library",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./styles/leaflet.css": "./src/styles/leaflet.css",
    "./src/styles/leaflet.css": "./src/styles/leaflet.css"
  },
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "dev": "vite --open /demo/App.html",
    "build": "tsc -p tsconfig.json",
    "build:vite": "vite build",
    "build:types": "tsc -p tsconfig.types.json && node scripts/postbuild-types.mjs"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@turf/bbox-clip": "^7.3.5",
    "leaflet": "^1.9.0",
    "proj4": "^2.16.2",
    "proj4leaflet": "^1.0.2",
    "rbush": "^4.0.1"
  },
  "peerDependencies": {
    "maplibre-gl": "^4.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/rbush": "^4.0.0",
    "path": "^0.12.7",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "vite": "^7.1.7"
  },
  "sideEffects": true,
  "files": [
    "build/",
    "src/styles/",
    "src/types/",
    "types/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sl-utils/map.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sl-utils/map/issues"
  },
  "homepage": "https://github.com/sl-utils/map#readme",
  "publishConfig": {
    "access": "public"
  }
}